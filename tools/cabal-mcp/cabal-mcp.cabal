cabal-version: 3.0
name:          cabal-mcp
version:       0.1.0.0
synopsis:      MCP server that exposes cabal build/test/run as tools
license:       MIT
build-type:    Simple

executable cabal-mcp
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  ghc-options:      -Wall -threaded -rtsopts

  build-depends:
    base       >= 4.18 && < 4.23,
    mcp-server >= 0.1.0.20,
    text       >= 1.2  && < 3,
    process    >= 1.6  && < 2

  default-extensions:
    OverloadedStrings
    LambdaCase
