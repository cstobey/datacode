cabal-version: 3.0
name:          capnproto-spike
version:       0.1.0.0
synopsis:
  Feasibility spike — Cap'n Proto binary format + LMDB threading fix (OQ-003, OQ-004)
description:
  Proves four properties needed before writing core DataCode storage code:
  .
  1. Cap'n Proto wire format is implementable in Haskell without the capnp
     code-generation tool. The spike implements the format manually; production
     code uses capnp-generated Cerialize/Decerialize instances in its place.
  .
  2. mmap zero-copy field access works in Haskell. TxNode fields can be read
     at computed byte offsets from a mmap'd ByteString with no decode pass.
  .
  3. Schema evolution is automatic. Adding a new field to TxNode produces
     messages that old readers silently ignore (backward compat) and new
     readers can read from old data with the declared default (forward compat).
     No version byte, no branching decoder, no migration step.
  .
  4. The LMDB bound-thread panic from the storage spike (OQ-004) is fixed by
     wrapping all LMDB operations in runInBoundThread.
  .
  Requires: liblmdb-dev (apt install liblmdb-dev / brew install lmdb)
  Requires: mmap package (available on Hackage; uses mmap(2) syscall)

license:    MIT
author:     DataCode Contributors
build-type: Simple

common warnings
  ghc-options: -Wall -Wno-unused-top-binds -Wno-name-shadowing -threaded -rtsopts

executable capnproto-spike
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   app, src
  default-language: GHC2021

  other-modules:
    Spike.CapnProto
    Spike.ZeroCopy
    Spike.Evolution
    Spike.LmdbFixed

  default-extensions:
    OverloadedStrings
    LambdaCase
    RecordWildCards
    DeriveGeneric
    GeneralizedNewtypeDeriving
    ScopedTypeVariables

  build-depends:
    base              >= 4.14  && < 5,
    bytestring        >= 0.11  && < 0.13,
    cereal            >= 0.5   && < 0.6,
    mmap              >= 0.5   && < 0.6,
    lmdb              >= 0.2   && < 0.3,
    containers        >= 0.6   && < 0.8,
    time              >= 1.9   && < 2,
    directory         >= 1.3   && < 1.4,
    filepath          >= 1.4   && < 1.5
